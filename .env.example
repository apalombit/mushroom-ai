# =============================================================================
# Mushroom AI — Environment Configuration
# =============================================================================
# Copy to .env:  cp .env.example .env
# NEVER commit .env to version control.
# =============================================================================

# --- LLM (provider-agnostic via LiteLLM + Instructor) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
OLLAMA_NUM_CTX=32768

# Cloud providers (uncomment when ready)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_BASE_URL=
# ANTHROPIC_API_KEY=sk-ant-...

# --- Vision LLM (Ollama Cloud) — for image-grounded labeling pilots ---
# Used by vision/scripts/vlm_label_pilot.py and vision/labeling/vlm_labeler.py.
# The default text LLM_MODEL above usually isn't multimodal, so override the
# vision model per-call via the script's --model flag (or vision_completion(model=...)).
#
# IMPORTANT: cloud-tagged models only resolve when LLM_BASE_URL points at Ollama
# Cloud (https://ollama.com) and OLLAMA_API_KEY is set — they will 404 against a
# local Ollama daemon.
#   LLM_BASE_URL=https://ollama.com
#   OLLAMA_API_KEY=...
#
# Cloud-hosted VLMs (verify on https://ollama.com/search?c=cloud):
#   gemma4:31b-cloud         # ~31B, 256K ctx, text+image — recommended starting point (smallest, fastest)
#   qwen3.5:cloud            # ~397B, 256K ctx, text+image — larger alternate
#   qwen3-vl:235b-cloud      # ~235B, 256K ctx, text+image — Qwen VL alternate

# --- PostgreSQL + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mushroom_ai
POSTGRES_USER=mushroom
POSTGRES_PASSWORD=mushroom_dev

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Similarity defaults ---
WEIGHT_MORPHOLOGICAL=0.60
WEIGHT_ECOLOGICAL=0.25
WEIGHT_TAXONOMIC=0.15

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development
