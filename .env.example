# =============================================================================
# Mushroom AI — Environment Configuration
# =============================================================================
# Copy to .env:  cp .env.example .env
# NEVER commit .env to version control.
# =============================================================================

# --- LLM (provider-agnostic via LiteLLM + Instructor) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Cloud providers (uncomment when ready)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_BASE_URL=
# ANTHROPIC_API_KEY=sk-ant-...

# --- PostgreSQL + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mushroom_ai
POSTGRES_USER=mushroom
POSTGRES_PASSWORD=mushroom_dev

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Similarity defaults ---
WEIGHT_MORPHOLOGICAL=0.60
WEIGHT_ECOLOGICAL=0.25
WEIGHT_TAXONOMIC=0.15

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development
