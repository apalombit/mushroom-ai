# =============================================================================
# Mushroom AI — Environment Configuration
# =============================================================================
# Copy to .env:  cp .env.example .env
# NEVER commit .env to version control.
# =============================================================================

# --- LLM (provider-agnostic via LiteLLM + Instructor) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
OLLAMA_NUM_CTX=32768

# Cloud providers (uncomment when ready)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_BASE_URL=
# ANTHROPIC_API_KEY=sk-ant-...

# --- Vision LLM (Ollama Cloud) — for image-grounded labeling pilots ---
# Used by vision/scripts/vlm_label_pilot.py and vision/labeling/vlm_labeler.py.
# The default text LLM_MODEL above usually isn't multimodal, so override the
# vision model per-call via the script's --model flag (or vision_completion(model=...)).
#
# IMPORTANT: cloud-tagged models only resolve when LLM_BASE_URL points at Ollama
# Cloud (https://ollama.com) and OLLAMA_API_KEY is set — they will 404 against a
# local Ollama daemon.
#   LLM_BASE_URL=https://ollama.com
#   OLLAMA_API_KEY=...
#
# Cloud-hosted VLMs (verify on https://ollama.com/search?c=cloud):
#   gemma4:31b-cloud         # ~31B, 256K ctx, text+image — recommended starting point (smallest, fastest)
#   qwen3.5:cloud            # ~397B, 256K ctx, text+image — larger alternate
#   qwen3-vl:235b-cloud      # ~235B, 256K ctx, text+image — Qwen VL alternate

# --- PostgreSQL + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mushroom_ai
POSTGRES_USER=mushroom
POSTGRES_PASSWORD=mushroom_dev

# --- Embeddings ---
EMBEDDING_MODEL=all-mpnet-base-v2
# Grouping profile from ingestion/profiles/ — defines the embedding groups
GROUPING_PROFILE=finer_grps

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Similarity defaults ---
# Per-group weights (WEIGHT_<GROUP>) for the finer_grps profile, tuned with
# `python -m scripts.eval --sweep`. Unset groups share the remainder evenly;
# all weights are normalised to sum to 1.0.
WEIGHT_BODY_FORM_FILTER=false
WEIGHT_NUMERIC=0.0759
WEIGHT_SIZE=0.0073
WEIGHT_SHAPE=0.0166
WEIGHT_CAP_COLOR=0.0933
WEIGHT_STEM_COLOR=0.0218
WEIGHT_CAP_SHAPE=0.0101
WEIGHT_CAP_DEPRESS=0.0035
WEIGHT_CAP_FEEL=0.0036
WEIGHT_CAP_TEXT=0.0076
WEIGHT_CAP_ORNAMENTS=0.0182
WEIGHT_CAP_MARGIN=0.0014
WEIGHT_CAP_VIZ=0.0196
WEIGHT_CAP_BRUISE=0.0290
WEIGHT_HYMENIUM=0.0284
WEIGHT_GILLS_ATTACH=0.1382
WEIGHT_GILLS_DISTRIB=0.0301
WEIGHT_GILLS_VIZ=0.0096
WEIGHT_PORES=0.0015
WEIGHT_PORES_BRUISE=0.0149
WEIGHT_STEM_SHAPE=0.0030
WEIGHT_STEM_ATTACH=0.0032
WEIGHT_STEM=0.0063
WEIGHT_STEM_SURF=0.0040
WEIGHT_STEM_BRUISE=0.0258
WEIGHT_STEM_AGE=0.0068
WEIGHT_STEM_BASECOL=0.0099
WEIGHT_VEIL=0.0257
WEIGHT_CORTINA=0.0571
WEIGHT_VEIL_COLOUR=0.0255
WEIGHT_VEIL_SHAPE=0.0194
WEIGHT_RING_POS=0.0027
WEIGHT_RING_PERS=0.0284
WEIGHT_RING_MOV=0.0109
WEIGHT_VOLVA=0.0219
WEIGHT_VOLVA_SHAPE=0.0209
WEIGHT_VOLVA_COL=0.0014
WEIGHT_FLESH_VISUAL=0.0076
WEIGHT_FLESH_INNER=0.0445
WEIGHT_UNIFORMITY=0.0521
WEIGHT_LATEX=0.0209
WEIGHT_FLESH_PERCEPTIVE=0.0076
WEIGHT_SPORE_VIS=0.0040
WEIGHT_ECOLOGICAL=0.0107
WEIGHT_HABITAT=0.0037
WEIGHT_TREES=0.0121
WEIGHT_GROWTH=0.0191
WEIGHT_TAXONOMIC=0.0143

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development
